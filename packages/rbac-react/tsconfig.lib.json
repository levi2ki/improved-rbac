{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["es2022", "dom"],
    "types": ["node", "react"],
    "sourceMap": false,
    "declarationMap": false,
    "stripInternal": false,
    "removeComments": true,
    "customConditions": ["development"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "references": [
    { "path": "../rbac-core/tsconfig.lib.json" },
    { "path": "../rbac-expression/tsconfig.lib.json" }
  ],
  "exclude": ["jest.config.ts", "src/**/*.spec.ts", "src/**/*.spec.tsx", "src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.type-test.ts", "src/**/*.type-test.tsx", "src/**/*.mock.ts", "src/**/*.mock.tsx", "src/lib/test-registry.ts"]
}
