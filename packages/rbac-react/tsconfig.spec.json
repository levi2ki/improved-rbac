{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/jest",
    "types": ["jest", "node", "react", "react-dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["es2022", "dom"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["jest.config.ts", "src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.type-test.ts", "src/**/*.type-test.tsx", "src/**/*.d.ts", "src/lib/test-registry.ts"],
  "references": [{ "path": "./tsconfig.lib.json" }]
}
